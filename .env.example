# Copy to .env and adjust. Never commit .env.

# --- AI (server-side only; never exposed to the browser) -------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional API gateway / proxy
# ANTHROPIC_BASE_URL=
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Server-side refusal fallback (beta). Set to false to disable.
ANTHROPIC_ENABLE_FALLBACKS=true
# anthropic | none
AI_PROVIDER=anthropic

# --- Local development without Docker (Docker Compose sets these itself) ----
# DATABASE_URL=sqlite:///./data/pcbai.db
# DATABASE_URL=postgresql+psycopg://pcbai:pcbai@localhost:5432/pcbai
# STORAGE_ROOT=./data/storage
# inline (thread pool) | eager (synchronous) | celery
# JOB_BACKEND=inline
# REDIS_URL=redis://localhost:6379/0

# --- KiCad engine --------------------------------------------------------------
# local: run kicad-cli / KiCad Python as subprocesses
# docker: run every EDA command in a fresh network-less kicad/kicad container
# KICAD_EXEC_MODE=local
# KICAD_CLI=kicad-cli
# Python interpreter that can `import pcbnew` (e.g. python3.12 on Ubuntu 24.04)
# KICAD_PYTHON=python3
# KICAD_DOCKER_IMAGE=kicad/kicad:9.0
# Library directories used for parsing symbols/footprints (auto-detected if unset)
# KICAD_SYMBOL_DIR=/usr/share/kicad/symbols
# KICAD_FOOTPRINT_DIR=/usr/share/kicad/footprints
